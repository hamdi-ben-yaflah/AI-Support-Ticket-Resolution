{
  "name": "supporting-ticket",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:operations": "node scripts/build-operations.mjs",
    "start": "next start",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test:e2e:p2": "playwright test e2e/p2-journeys.spec.ts",
    "test:e2e:database": "NODE_OPTIONS=--conditions=react-server playwright test --config=playwright.database.config.ts",
    "test:e2e:live": "playwright test --config=playwright.live.config.ts",
    "test:e2e:install": "playwright install chromium",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=artifacts/unit-tests.xml",
    "db:generate": "drizzle-kit generate",
    "db:check": "node scripts/check-migrations.mjs",
    "db:migrate": "drizzle-kit migrate",
    "ingest": "NODE_OPTIONS=--conditions=react-server tsx scripts/ingest.ts",
    "ingest:replay": "INGESTION_MODE=replay NODE_OPTIONS=--conditions=react-server tsx scripts/ingest.ts",
    "ingest:record": "INGESTION_MODE=record NODE_OPTIONS=--conditions=react-server tsx scripts/ingest.ts",
    "chunks:inspect": "NODE_OPTIONS=--conditions=react-server tsx scripts/inspect-chunks.ts",
    "eval": "NODE_OPTIONS=--conditions=react-server tsx scripts/eval.ts",
    "eval:replay": "EVALUATION_MODE=replay NODE_OPTIONS=--conditions=react-server tsx scripts/eval.ts",
    "eval:record": "EVALUATION_MODE=record NODE_OPTIONS=--conditions=react-server tsx scripts/eval.ts",
    "test:integration": "vitest run --config vitest.integration.config.mts --reporter=default --reporter=junit --outputFile=artifacts/integration-tests.xml",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm db:check && pnpm test:coverage && pnpm build:operations && pnpm build"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@langfuse/otel": "^5.11.1",
    "@next/env": "^16.4.2",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "drizzle-orm": "^0.45.4",
    "gpt-tokenizer": "^4.1.0",
    "gray-matter": "^4.0.3",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-to-string": "^4.0.0",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "voyageai": "0.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "@vitest/coverage-v8": "^5.0.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.21.0"
}
