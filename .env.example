ANTHROPIC_API_KEY=
LLM_MODEL=
AI_REQUEST_TIMEOUT_MS=15000
AI_MAX_RETRIES=2
# Anthropic system-prompt caching. Set to false to compare an evaluation run with caching off.
ANTHROPIC_PROMPT_CACHE_ENABLED=true
LOG_LEVEL=info
# Optional metadata-only Langfuse tracing. Keep disabled unless both keys are set.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_ENVIRONMENT=
LANGFUSE_RELEASE=
RESOLUTION_MINIMUM_CONFIDENCE=0.65
SESSION_COOKIE_SECRET=
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-4
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=64
EMBEDDING_REQUEST_TIMEOUT_MS=20000
EMBEDDING_MAX_RETRIES=2
DATABASE_URL=postgresql://support_copilot:support_copilot_local@127.0.0.1:5432/support_copilot
TEST_DATABASE_URL=postgresql://support_copilot_test:support_copilot_test_local@127.0.0.1:5433/support_copilot_test
E2E_DATABASE_URL=postgresql://support_copilot_test:support_copilot_test_local@127.0.0.1:5433/support_copilot_test
DATABASE_READINESS_TIMEOUT_MS=3000
RETRIEVAL_CANDIDATE_COUNT=8
RETRIEVAL_FINAL_COUNT=5
RETRIEVAL_MINIMUM_SIMILARITY=0.65
RETRIEVAL_MAXIMUM_CONTEXT_TOKENS=3500
RETRIEVAL_MINIMUM_EVIDENCE_COUNT=1
INVESTIGATION_TOOL_TIMEOUT_MS=3000
EVAL_ANTHROPIC_INPUT_USD_PER_MILLION=
EVAL_ANTHROPIC_OUTPUT_USD_PER_MILLION=
# Cache pricing must be set together with the two prices above, or all four left empty.
EVAL_ANTHROPIC_CACHE_READ_USD_PER_MILLION=
EVAL_ANTHROPIC_CACHE_WRITE_USD_PER_MILLION=
ENABLE_LIVE_EVALUATIONS=true
# Keep the live-provider browser smoke disabled unless explicitly approved and budgeted.
LIVE_PROVIDER_SMOKE=false
LIVE_PROVIDER_SMOKE_BUDGET_USD=

# Required canonical origin in production, e.g. https://support.example.com (no trailing slash).
APP_ORIGIN=
# Optional limits: defaults 20 requests/minute, 2 concurrent, 5/minute/verified session.
RESOLUTION_RATE_PER_MINUTE=
RESOLUTION_MAX_CONCURRENT=
RESOLUTION_SESSION_RATE_PER_MINUTE=
